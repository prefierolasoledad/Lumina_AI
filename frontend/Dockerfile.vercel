# syntax=docker/dockerfile:1
#
# Vercel container build for the Lumina AI frontend.
#
# Vercel detects `Dockerfile.vercel` at the project root (set the project's Root
# Directory to `frontend/`), builds it on every commit, pushes the image to the
# Vercel Container Registry and serves it from an autoscaling Fluid function.
#
# Differences from the plain ./Dockerfile, which exists for docker compose:
#
#   1. The backend URLs are baked in here as ENV rather than passed as build args.
#      Vercel does not expose `--build-arg`, and these values MUST be present at
#      BUILD time: `rewrites()` in next.config.ts is evaluated during the build and
#      frozen into the routes manifest, and NEXT_PUBLIC_* is inlined into the client
#      bundle. They are public URLs, not secrets. Real secrets stay in Vercel's
#      project environment variables and are read at runtime.
#   2. wss:// and https://, never ws:// or http:// — Vercel serves the page over
#      HTTPS and the browser blocks mixed-content connections.
#
# ── EDIT THESE TWO before the first deploy ────────────────────────────────────
ARG BACKEND_ORIGIN=https://luminaai-production-e210.up.railway.app
ARG BACKEND_WS_ORIGIN=wss://luminaai-production-e210.up.railway.app

# ---- Deps stage: install all dependencies ----
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# ---- Build stage: produce the standalone server bundle ----
FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG BACKEND_ORIGIN
ARG BACKEND_WS_ORIGIN
# Server-side only: the Next.js proxy rewrite target for /api/*.
ENV NEXT_PUBLIC_API_URL=$BACKEND_ORIGIN/api
# Browser-side: the WebSocket connects directly to the backend, bypassing the proxy.
ENV NEXT_PUBLIC_WS_URL=$BACKEND_WS_ORIGIN
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---- Runtime stage ----
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
# Vercel routes container traffic to port 80 by default. Keep this in sync with
# the PORT variable in the Vercel project settings if you change it.
ENV PORT=3000

# The standalone output bundles a minimal server.js plus only the traced
# node_modules. public/ and .next/static must be copied in alongside it.
COPY --from=build /app/public ./public
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

USER node
EXPOSE 3000
CMD ["node", "server.js"]
